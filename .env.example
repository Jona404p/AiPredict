# ─── PredictIA — Variables de entorno ────────────────────────────────────────
#
# football-data.org (OPCIONAL — mejora la fiabilidad de datos)
# Registro gratuito en: https://www.football-data.org/client/register
# Con API key gratuita: 10 competiciones, 10 req/min
#
FOOTBALL_DATA_API_KEY=tu_api_key_aqui

# ─── SofaScore ────────────────────────────────────────────────────────────────
# No requiere API key — API pública.
# Si SofaScore bloquea tu servidor, considera usar un proxy.

# ─── Ollama (Chatbot local con qwen2.5:3b) ───────────────────────────────────
# Por defecto apunta a localhost:11434
# Si Next.js corre en Docker o en un servidor diferente, ajusta la URL:
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
